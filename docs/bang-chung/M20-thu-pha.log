######## t4.sh
#!/usr/bin/env bash
# t4: mật khẩu job (DB rời), vòng đời token (hạ vai, khoá, đặt lại mật khẩu, xoá rồi tạo lại user),
# view-as, chính sách bắt buộc vượt bằng token hay phiên cũ.
. /home/ubuntu/tps/lib.sh
tc() {
  local t=$1 m=$2 p=$3
  shift 3
  printf 'Authorization: Bearer %s' "$(cat "$T/tk.$t")" >"$T/h.auth"
  curl -sk -o "$T/body" -w '%{http_code}' -H @"$T/h.auth" -X "$m" "$@" "$B$p" >"$T/code"
  printf '[tk %s] %s %s -> HTTP %s %s\n' "$t" "$m" "$p" "$(code)" "$(head -c 160 "$T/body" | tr '\n' ' ')" | mask
}
mk() {
  tpan token create "$2" --name "$1" --scope "$3" --days 30 --yes --json >"$T/tkc.$1" 2>&1
  jq -r '.token // empty' "$T/tkc.$1" >"$T/tk.$1"; keep "$(cat "$T/tk.$1")"
  echo "token $1 ($2, $3) đã tạo"
}
sk() { jq -c '[paths|join(".")|select(test("secret"))]' "$T/body"; }
mk K3 khach databases:write,jobs:read

say "4.1 job tạo DB rời bằng token K (có db_secret): ai lấy được mật khẩu"
tc K POST /api/v1/dbs -H 'Content-Type: application/json' --data '{"name":"khach_t4"}'
JOB=$(jq -r '.job_id // empty' "$T/body"); echo "job: $JOB"
for i in $(seq 1 30); do tc K2 GET "/api/v1/jobs/$JOB" >/dev/null; [ "$(jq -r '.job.status' "$T/body")" != running ] && break; sleep 2; done
echo "trạng thái job: $(jq -r '.job.status' "$T/body")"
tc K2 GET "/api/v1/jobs/$JOB" >/dev/null; echo "token khác (K2) của cùng user: khoá secret $(sk)"
tc K3 GET "/api/v1/jobs/$JOB" >/dev/null; echo "token khác (K3) của cùng user: khoá secret $(sk)"
login a2 admin2 >/dev/null; c a2 GET "/api/v1/jobs/$JOB" >/dev/null; echo "phiên admin2 (admin): HTTP $(code) khoá secret $(sk)"
tc K GET "/api/v1/jobs/$JOB" >/dev/null; echo "token K (người khởi): khoá secret $(sk)"
jq -r '.db_secret | .. | strings' "$T/body" 2>/dev/null | while read -r x; do [ ${#x} -ge 12 ] && keep "$x"; done
tc K GET "/api/v1/jobs/$JOB" >/dev/null; echo "token K lần hai: khoá secret $(sk)"

say "4.2 token A2 (admin2: system:read, sites:write) qua hạ vai, khoá, mở khoá, nâng lại"
tc A2 GET /api/v1/stack
tpan user edit admin2 --role user --yes >/dev/null 2>&1; echo "tpan user edit admin2 --role user: rc=$?"
tc A2 GET /api/v1/stack
tc A2 GET /api/v1/sites
tc A2 POST /api/v1/sites/a.example.com/suspend -H 'Content-Type: application/json' --data '{}'
tpan user edit admin2 --role admin --yes >/dev/null 2>&1; echo "tpan user edit admin2 --role admin (nâng lại): rc=$?"
tc A2 GET /api/v1/stack
echo "(token sống lại sau khi nâng vai lại: theo thiết kế, quyền = vai hiện tại ∩ phạm vi)"
tpan user suspend admin2 --yes >/dev/null 2>&1; echo "tpan user suspend admin2: rc=$?"
tc A2 GET /api/v1/stack
tpan user unsuspend admin2 --yes >/dev/null 2>&1; echo "tpan user unsuspend admin2: rc=$?"
tc A2 GET /api/v1/stack
echo "trạng thái token A2: $(tpan token list 2>/dev/null | grep -w A2 | awk '{print $NF}')"

say "4.3 đặt lại mật khẩu khach (admin) -> token của khach bị thu hồi"
tc KR GET /api/v1/sites >/dev/null; echo "KR trước: HTTP $(code)"
tpan user passwd khach --yes --json >"$T/up.khach" 2>&1; echo "tpan user passwd khach: rc=$?"
jq -r '.password // empty' "$T/up.khach" >"$T/pw.khach.new"; [ -s "$T/pw.khach.new" ] && { keep "$(cat "$T/pw.khach.new")"; cp "$T/pw.khach.new" "$T/pw.khach"; }
for t in K K2 K3 KR; do tc $t GET /api/v1/sites; done

say "4.4 xoá user vic2 rồi tạo lại cùng tên -> token cũ V2"
tc V2 GET /api/v1/sites
tpan user rm vic2 --yes >/dev/null 2>&1; echo "tpan user rm vic2: rc=$?"
tc V2 GET /api/v1/sites
tpan user add vic2 --role user --yes --json >"$T/ua.vic2b" 2>&1; echo "tpan user add vic2 (lại): rc=$?"; keep "$(jq -r .password "$T/ua.vic2b")"
tc V2 GET /api/v1/sites
echo "dòng api_tokens của vic2: $(sq "select count(*) from api_tokens where user_name='vic2'"); user_totp: $(sq "select count(*) from user_totp where user_name='vic2'"); mã dự phòng: $(sq "select count(*) from user_recovery_codes where user_name='vic2'")"

say "4.5 view-as: admin2 xem như khach"
login a2 admin2 >/dev/null
c a2 POST /api/v1/users/khach/view-as -H 'Content-Type: application/json' --data '{}'
echo "(F1/reauth: xem như có cần mật khẩu? ghi nhận mã ở trên)"
c a2 GET /api/v1/session
c a2 GET /api/v1/sites
c a2 GET /api/v1/account/tokens
c a2 POST /api/v1/account/tokens -H 'Content-Type: application/json' --data '{"name":"va","scopes":["sites:read"],"days":1}'
c a2 POST /api/v1/account/2fa/setup -H 'Content-Type: application/json' --data '{}'
c a2 POST /api/v1/account/2fa/disable -H 'Content-Type: application/json' --data '{}'
c a2 GET /api/v1/account/2fa
c a2 POST /api/v1/session/view-as/exit -H 'Content-Type: application/json' --data '{}'

say "4.6 chính sách 'all': token và phiên cũ của user chưa bật hai bước"
tpan user add nopol --role user --yes --json >"$T/ua.nopol" 2>&1; jq -r .password "$T/ua.nopol" >"$T/pw.nopol"; keep "$(cat "$T/pw.nopol")"
mk NP nopol sites:read
login np nopol >/dev/null; c np GET /api/v1/sites >/dev/null; echo "phiên nopol trước chính sách: HTTP $(code)"
login a2s admin2 >/dev/null; c a2s GET /api/v1/stack >/dev/null; echo "phiên admin2 (chưa bật) trước chính sách: HTTP $(code)"
tpan user 2fa policy all --yes 2>&1 | tail -2 | mask
tc NP GET /api/v1/sites
c np GET /api/v1/sites
c np GET /api/v1/session
c np POST /api/v1/account/2fa/setup -H 'Content-Type: application/json' --data '{}'
echo "(setup cho phép: allowEnroll; bí mật mới không in)"
keep "$(jq -r '.secret // empty' "$T/body")"
c np POST /api/v1/session/view-as/exit -H 'Content-Type: application/json' --data '{}'
c a2s GET /api/v1/stack
c a2s POST /api/v1/users/khach/view-as -H 'Content-Type: application/json' --data '{}'
tc A2 GET /api/v1/stack
tpan user 2fa policy off --yes 2>&1 | tail -1 | mask

