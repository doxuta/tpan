######## t1.sh
#!/usr/bin/env bash
# t1: vượt bước hai bằng phiếu chờ (user khach đã bật hai bước).
. /home/ubuntu/tps/lib.sh
say "1.1 khach đăng nhập mật khẩu -> phiếu chờ (cookie __Host-tpan-2fa)"
login p khach
grep -o '__Host-tpan[-a-z0-9]*' "$T/p" | sort -u
PV=$(awk '$6=="__Host-tpan-2fa"{print $7}' "$T/p")
keep "$PV"

say "1.2 phiếu chờ gọi các route cần phiên (kỳ vọng 401 hết)"
for p in /api/v1/sites /api/v1/overview /api/v1/account/2fa /api/v1/account/tokens /api/v1/account/sessions \
  /api/v1/jobs /api/v1/jobs/x/events /api/v1/sites/k.example.org /api/v1/export /api/v1/backups; do
  c p GET "$p"
done
c p POST /api/v1/account/2fa/disable -H 'Content-Type: application/json' --data '{}'
c p POST /api/v1/account/password -H 'Content-Type: application/json' --data '{}'
c p POST /api/v1/sites -H 'Content-Type: application/json' --data '{"domain":"z.example.com"}'
c p GET /api/v1/session

say "1.3 đường dẫn lạ, mã hoá, .. (curl --path-as-is)"
for p in '/api/v1/../api/v1/sites' '/api/v1/%2e%2e/v1/sites' '/api//v1/sites' '/API/v1/sites' '/api/v1/sites/' \
  '/api/v1/sites%2f' '/./api/v1/sites' '/api/v1/sites/..%2fsites' '/api/v1/health/../sites' '/api/v1/login/../sites' \
  '/api/v1/sites/k.example.org%2f..%2f..%2fusers' '/api/v1/session/../sites' '/api/v1/sites?x=/api/v1/health' '/%61pi/v1/sites'; do
  curl -sk --path-as-is -o "$T/body" -w '%{http_code}' -b "$T/p" "$B$p" >"$T/code"
  printf 'GET %s -> HTTP %s %s\n' "$p" "$(code)" "$(head -c 160 "$T/body" | tr '\n' ' ')" | mask
done

say "1.4 nâng phiếu thành phiên: gửi giá trị phiếu dưới tên cookie phiên"
for n in __Host-tpan tpan; do
  curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: $n=$PV" "$B/api/v1/sites" >"$T/code"
  echo "Cookie $n=<phiếu> GET /api/v1/sites -> HTTP $(code) $(head -c 160 "$T/body")" | mask
done
curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: __Host-tpan=$PV; __Host-tpan-2fa=$PV" "$B/api/v1/sites" >"$T/code"
echo "cả hai cookie = phiếu -> HTTP $(code) $(head -c 160 "$T/body")" | mask
echo "phiếu trong bảng sessions? $(sq "select count(*) from sessions where user_name='khach'") phiên của khach"

say "1.5 phiếu từ IP khác (cùng Host 127.0.0.1, kết nối từ <vm>) và Host khác (localhost)"
wait_fresh
codejson "$(totp khach)"
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/p" --connect-to "127.0.0.1:8443:$VMIP:8443" -H 'Content-Type: application/json' \
  --data-binary @"$T/req.code" "$B/api/v1/login/2fa" >"$T/code"
echo "IP nguồn <vm>, mã đúng -> HTTP $(code) $(head -c 200 "$T/body")" | mask
curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: __Host-tpan-2fa=$PV" -H 'Host: localhost' -H 'Content-Type: application/json' \
  --data-binary @"$T/req.code" "$B/api/v1/login/2fa" >"$T/code"
echo "Host localhost, mã đúng -> HTTP $(code) $(head -c 200 "$T/body")" | mask
echo "phiếu còn trong DB: $(sq "select count(*) from login_challenges where user_name='khach'")"
c p POST /api/v1/login/2fa -H 'Content-Type: application/json' --data-binary @"$T/req.code"
echo "(đúng IP, đúng Host, cùng mã — mã chưa bị dùng ở hai lần trên thì 204)"
c p GET /api/v1/sites
SV=$(awk '$6=="__Host-tpan"{print $7}' "$T/p")
keep "$SV"
echo "phiếu sau khi vào: $(sq "select count(*) from login_challenges where user_name='khach'") (phiếu cũ còn thì là lỗi)"
curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: __Host-tpan-2fa=$PV" -H 'Content-Type: application/json' --data-binary @"$T/req.code" "$B/api/v1/login/2fa" >"$T/code"
echo "dùng lại phiếu đã tiêu -> HTTP $(code) $(head -c 160 "$T/body")" | mask

say "1.6 cookie phiên chép sang Host khác"
cp "$T/p" "$T/p.bak"
for h in 'Host: 127.0.0.1.' 'Host: 127.0.0.1:9999' 'Host: [::1]'; do
  curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: __Host-tpan=$SV" -H "$h" "$B/api/v1/session" >"$T/code"
  echo "$h -> HTTP $(code) $(head -c 120 "$T/body")" | mask
done
echo "(127.0.0.1. và :9999 chuẩn hoá về cùng tên; [::1] là tên khác)"
curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: __Host-tpan=$SV" "$B/api/v1/session" >"$T/code"
echo "Host gốc sau lần [::1] -> HTTP $(code) $(head -c 120 "$T/body")" | mask

