# M20 — thử phá trên máy ảo (soát cuối bảo mật, phần máy ảo)
# Máy ảo: tpan-m20 (Multipass, Ubuntu 24.04), bản tpan v0.2.2-113-g5043e04 (commit 5043e04, nhánh moc/M20).
# Ngày chạy: 2026-11-25 (giờ máy 01:17–02:00). Chỉ trong máy ảo; mọi lệnh chạy bằng root TRONG máy ảo, panel gọi ở https://127.0.0.1:8443.
# Che: mật khẩu, bí mật TOTP (base32, hex, ma trận QR), mã dự phòng, token, cookie, mật khẩu DB của job => <che>; token dạng tpan_... => tpan_<token>; IP máy ảo => <vm>.
# Mã TOTP tính trong máy ảo bằng oathtool (gói Ubuntu) và không bao giờ in.
# Cấu trúc: với mỗi phần, nguyên văn script đã chạy (lệnh), rồi output thật của nó.

######## DỰNG
$ make build-linux && scripts/vm.sh reset && scripts/vm.sh deploy   (trên Mac)
$ scripts/vm.sh root: tpan stack install --web nginx --yes  -> stack rc=0
$ apt-get install -y oathtool jq sqlite3 -> rc=0
$ tpan setup --yes -> setup rc=0 (mật khẩu admin giữ ở /root/tp/pw.admin trong máy ảo, 0600)
$ tpan user add khach|vic|vic2 --role user; tpan user add admin2 --role admin  (mật khẩu giữ trong /root/tp)
$ tpan site add a.example.com (chủ admin) -> rc=0; tpan site add k.example.org --owner khach -> rc=0

######## THƯ VIỆN: lib.sh
# Thư viện thử phá M20, chạy TRONG máy ảo bằng root. Bí mật nằm ở /root/tp (0700),
# không bao giờ in ra: mọi output đi qua mask.
T=/root/tp
mkdir -p "$T" && chmod 700 "$T"
umask 077
touch "$T/secrets"
B=https://127.0.0.1:8443
VMIP=$(hostname -I | awk '{print $1}')

mask() {
  local s p
  s=$(cat)
  while IFS= read -r p; do
    [ -n "$p" ] && s="${s//"$p"/<che>}"
  done <"$T/secrets"
  [ -n "$VMIP" ] && s="${s//"$VMIP"/<vm>}"
  s=$(sed -E 's/(set-cookie: *[^=<cookie>;]*/\1<cookie>/I; s/tpan_[A-Za-z0-9_-]{16,}/tpan_<token>/g' <<<"$s")
  printf '%s\n' "$s"
}
keep() { [ -n "$1" ] && printf '%s\n' "$1" >>"$T/secrets"; }
say() { printf '\n### %s\n' "$*"; }
# c <jar> <METHOD> <path> [curl args...]: in "HTTP <mã> <thân rút gọn>"
c() {
  local jar=$1 m=$2 p=$3
  shift 3
  curl -sk -o "$T/body" -w '%{http_code}' -b "$T/$jar" -c "$T/$jar" -X "$m" "$@" "$B$p" >"$T/code" 2>"$T/cerr"
  printf '%s %s %s -> HTTP %s %s\n' "$m" "$p" "[$jar]" "$(cat "$T/code")" "$(head -c 400 "$T/body" | tr '\n' ' ')" | mask
}
code() { cat "$T/code"; }
body() { cat "$T/body"; }
# login <jar> <user>: mật khẩu ở $T/pw.<user>
login() {
  : >"$T/$1"
  printf '{"name":"%s","password":"%s"}' "$2" "$(cat "$T/pw.$2")" >"$T/req.login"
  c "$1" POST /api/v1/login -H 'Content-Type: application/json' --data-binary @"$T/req.login"
}
# totp <user> [offset giây] -> mã ra stdout (không in ra log)
totp() {
  local off=${2:-0}
  oathtool --totp -b --now "$(date -u -d "@$(($(date +%s) + off))" '+%Y-%m-%d %H:%M:%S UTC')" "$(cat "$T/totp.$1")"
}
# wait_fresh: chờ vào đầu một bước TOTP mới (giây 1..3 của bước)
wait_fresh() {
  local s
  while :; do s=$(($(date +%s) % 30)); [ "$s" -ge 1 ] && [ "$s" -le 3 ] && break; sleep 1; done
}
codejson() { printf '{"code":"%s"}' "$1" >"$T/req.code"; }
sq() { sqlite3 /var/lib/tpan/tpan.db "$@"; }

######## THƯ VIỆN: scan.py
#!/usr/bin/env python3
# scan.py <danh sách loại:giá trị> <file...>: đếm số lần mỗi LOẠI bí mật xuất hiện trong mỗi file
# (dạng chữ, và dạng byte thô cho bí mật TOTP và file khoá). Không in giá trị.
import base64, sys

pats = []
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    line = line.rstrip("\n")
    if ":" not in line:
        continue
    kind, val = line.split(":", 1)
    if len(val) < 8:
        continue
    pats.append((kind, val.encode()))
    if kind == "totp":
        raw = base64.b32decode(val + "=" * (-len(val) % 8))
        pats.append(("totp-raw", raw))
        pats.append(("totp-hex", raw.hex().encode()))
        pats.append(("totp-b32-lower", val.lower().encode()))
    if kind == "rc":
        pats.append(("rc-nodash", val.replace("-", "").encode()))
        pats.append(("rc-lower", val.lower().encode()))
total = 0
for f in sys.argv[2:]:
    try:
        data = open(f, "rb").read()
    except OSError as e:
        print(f"{f}: không đọc được ({e.strerror})")
        continue
    hits = {}
    for kind, p in pats:
        n = data.count(p)
        if n:
            hits[kind] = hits.get(kind, 0) + n
    total += sum(hits.values())
    print(f"{f}: {len(data)} byte, trúng: {hits if hits else 0}")
print(f"TỔNG trúng: {total}")

######## en2fa.sh (bật hai bước qua API cho admin, khach, vic, vic2)
#!/usr/bin/env bash
# en2fa.sh <user>: bật hai bước cho user qua API; giữ bí mật, mã dự phòng trong /root/tp.
. /home/ubuntu/tps/lib.sh
u=$1
say "bật hai bước cho $u"
login "j.$u" "$u"
c "j.$u" POST /api/v1/account/2fa/setup -H 'Content-Type: application/json' --data '{}' >/dev/null
echo "setup -> HTTP $(code), khoá: $(jq -c 'keys' "$T/body")"
jq -r .secret "$T/body" >"$T/totp.$u"
keep "$(cat "$T/totp.$u")"
# bản hex của bí mật, để quét sau
python3 -c 'import base64,sys;s=open(sys.argv[1]).read().strip();print(base64.b32decode(s+"="*(-len(s)%8)).hex())' "$T/totp.$u" >"$T/totphex.$u"
keep "$(cat "$T/totphex.$u")"
wait_fresh
printf '{"password":"%s","code":"%s"}' "$(cat "$T/pw.$u")" "$(totp "$u")" >"$T/req.en"
c "j.$u" POST /api/v1/account/2fa/enable -H 'Content-Type: application/json' --data-binary @"$T/req.en" >/dev/null
echo "enable -> HTTP $(code), khoá: $(jq -c 'keys' "$T/body")"
jq -r '.recovery_codes[]' "$T/body" >"$T/rc.$u"
while read -r x; do keep "$x"; keep "${x//-/}"; done <"$T/rc.$u"
echo "mã dự phòng: $(wc -l <"$T/rc.$u") (không in)"
---- output

### bật hai bước cho admin
POST /api/v1/login [j.admin] -> HTTP 204 
setup -> HTTP 200, khoá: ["account","issuer","qr","secret","uri"]
enable -> HTTP 200, khoá: ["recovery_codes"]
mã dự phòng: 10 (không in)

### bật hai bước cho khach
POST /api/v1/login [j.khach] -> HTTP 204 
setup -> HTTP 200, khoá: ["account","issuer","qr","secret","uri"]
enable -> HTTP 200, khoá: ["recovery_codes"]
mã dự phòng: 10 (không in)

### bật hai bước cho vic
