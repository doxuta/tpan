######## t7.sh
#!/usr/bin/env bash
# t7: phần cuối của 6.5 và đua chiều ngược; cookie chép sang Host IP; site có SSL thật (pebble): 421 với SNI,
# cổng 443 theo IP không lộ cookie.
. /home/ubuntu/tps/lib.sh
issuer() {
  echo | timeout 8 openssl s_client -connect 127.0.0.1:${2:-8443} -servername "$1" 2>/dev/null |
    openssl x509 -noout -issuer -ext subjectAltName 2>/dev/null | tr '\n' ' ' | sed 's/X509v3 Subject Alternative Name: *//'
  echo
}
say "6.5 (tiếp) sau lần đua CLI trước API"
echo "panel.domain = $(tpan panel domain show --json 2>/dev/null | jq -r .domain)"
echo "site race.m20.test trong DB: $(sq "select count(*) from sites where domain='race.m20.test'")"
echo "SNI race.m20.test: $(issuer race.m20.test)"
login r1 admin2 >/dev/null
c r1 POST /api/v1/sites -H 'Content-Type: application/json' --data '{"domain":"race.m20.test","email":"admin@example.com"}'
tpan panel domain set --clear --yes >/dev/null 2>&1; echo "--clear: rc=$?"

say "6.6 đua chiều ngược: API tạo site race2.m20.test trước, CLI đặt tên panel race2.m20.test ngay sau"
grep -q ' race2.m20.test$' /etc/hosts || echo '127.0.0.1 race2.m20.test' >>/etc/hosts
c r1 POST /api/v1/sites -H 'Content-Type: application/json' --data '{"domain":"race2.m20.test","email":"admin@example.com"}'
JR=$(jq -r '.job_id // empty' "$T/body")
tpan panel domain set race2.m20.test --yes >"$T/race2.pd" 2>&1; echo "CLI panel domain set race2.m20.test (khi job site đang chạy): rc=$? $(grep -m1 -iE 'từ chối|lỗi|đang' "$T/race2.pd" | head -c 220)"
for i in $(seq 1 80); do c r1 GET "/api/v1/jobs/$JR" >/dev/null; s=$(jq -r '.job.status // empty' "$T/body"); [ -n "$s" ] && [ "$s" != running ] && break; sleep 3; done
echo "job site race2: $s"
tpan panel domain set race2.m20.test --yes >"$T/race2.pd" 2>&1; echo "CLI set race2.m20.test sau khi site xong: rc=$? $(grep -m1 -iE 'từ chối|lỗi' "$T/race2.pd" | head -c 160)"
echo "panel.domain = $(tpan panel domain show --json 2>/dev/null | jq -r .domain)"

say "6.7 cookie phiên chép sang Host là IP máy ảo"
login h2 admin2 >/dev/null
SV=$(awk '$6=="__Host-tpan"{print $7}' "$T/h2"); keep "$SV"
curl -sk -o "$T/body" -w '%{http_code}' -H "Cookie: __Host-tpan=$SV" "https://$VMIP:8443/api/v1/session" >"$T/code"
echo "cookie (đặt ở Host 127.0.0.1) gửi tới https://<vm>:8443 -> HTTP $(code) $(head -c 60 "$T/body")"
c h2 GET /api/v1/session >/dev/null; echo "phiên gốc sau đó: $(head -c 40 "$T/body")"
echo "audit session.host_mismatch: $(sq "select count(*) from audit where action='session.host_mismatch'")"

say "6.8 site k.example.org có SSL thật (pebble): Host/SNI tên site tới 8443; cổng 443 theo IP"
tpan ssl issue k.example.org --yes >"$T/ssl.out" 2>&1; echo "tpan ssl issue k.example.org: rc=$? $(tail -1 "$T/ssl.out")"
echo "SNI k.example.org cổng 443 (nginx site): $(issuer k.example.org 443)"
echo "SNI k.example.org cổng 8443 (panel): $(issuer k.example.org)"
login h3 admin2 >/dev/null
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/h3" --resolve k.example.org:8443:127.0.0.1 https://k.example.org:8443/ >"$T/code"
echo "https://k.example.org:8443/ (SNI + Host tên site, có cookie) -> HTTP $(code) $(head -c 60 "$T/body")"
c h3 GET /api/v1/session >/dev/null; echo "phiên đó sau lần trên: $(head -c 40 "$T/body")"
curl -sk -o /dev/null -w '%{http_code}\n' "https://$VMIP/" >"$T/code" 2>"$T/cerr"; echo "https://<vm>/ (cổng 443, không SNI tên): HTTP $(cat "$T/code") $(head -c 120 "$T/cerr")"
curl -s -o /dev/null -w 'http://<vm>/ (cổng 80): HTTP %{http_code}\n' "http://$VMIP/"
echo "(cookie __Host- có Secure nên không đi qua http; 443 theo IP từ chối bắt tay nên không site nào nhận cookie của panel đặt theo IP)"

