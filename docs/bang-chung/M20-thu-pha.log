######## t2.sh
#!/usr/bin/env bash
# t2: đua bước hai: nhiều phiếu song song (đếm số lần đoán thật trước khi khoá user),
# dùng lại mã TOTP / mã dự phòng song song. User vic, vic2 đã bật hai bước.
. /home/ubuntu/tps/lib.sh
wrongcode() { # một mã 6 số khác mã của mọi bước -3..+3 của user $1
  local near="" d x
  for d in -90 -60 -30 0 30 60 90; do near="$near $(totp "$1" $d)"; done
  while :; do x=$(printf '%06d' $((RANDOM * 32768 % 1000000 + RANDOM % 1000))); [[ $near != *"$x"* ]] && break; done
  echo "$x"
}
li() { # li <jar> <user> <ip nguồn>: đăng nhập từ IP nguồn
