######## t5.sh
#!/usr/bin/env bash
# t5: lộ bí mật: DB + WAL, journal, /var/log, bản sao backup --all, MCP, câu trả lời API (trừ lần đầu); quyền file.
. /home/ubuntu/tps/lib.sh
L=$T/quet.txt
: >"$L"
for f in "$T"/pw.*; do [ -s "$f" ] && echo "password:$(cat "$f")" >>"$L"; done
for f in "$T"/totp.*; do echo "totp:$(cat "$f")" >>"$L"; done
for f in "$T"/rc.*; do while read -r x; do echo "rc:$x" >>"$L"; done <"$f"; done
for f in "$T"/tk.*; do [ -s "$f" ] && echo "token:$(cat "$f")" >>"$L"; done
echo "key-hex:$(xxd -p -c 64 /etc/tpan/secret.key)" >>"$L"
echo "key-b64:$(base64 -w0 /etc/tpan/secret.key)" >>"$L"
# cookie phiên, phiếu (giá trị thô; DB chỉ được giữ sha256)
awk '$6 ~ /^__Host-tpan/ && $7 != "" {print "cookie:" $7}' "$T"/p "$T"/ks "$T"/adm "$T"/a2 "$T"/j.* 2>/dev/null | sort -u >>"$L"
echo "danh sách quét: $(cut -d: -f1 "$L" | sort | uniq -c | tr '\n' ' ')"
# đối chứng: phép quét không mù
printf '%s\n' "$(grep -m1 '^totp:' "$L" | cut -d: -f2-)" >"$T/doichung.txt"
grep -m1 '^token:' "$L" | cut -d: -f2- >>"$T/doichung.txt"
say "5.0 đối chứng: file chứa một bí mật TOTP và một token"
python3 /home/ubuntu/tps/scan.py "$L" "$T/doichung.txt"

say "5.1 quyền file"
stat -c '%A %U:%G %s %n' /etc/tpan /etc/tpan/secret.key /var/lib/tpan /var/lib/tpan/tpan.db /var/lib/tpan/tpan.db-wal /var/lib/tpan/tpan.db-shm 2>&1
sudo -u ubuntu cat /etc/tpan/secret.key >/dev/null 2>&1; echo "user ubuntu đọc secret.key: rc=$?"
sudo -u ubuntu sqlite3 /var/lib/tpan/tpan.db 'select 1' >/dev/null 2>&1; echo "user ubuntu đọc tpan.db: rc=$?"
SITEU=$(stat -c %U /var/www/k.example.org 2>/dev/null || ls -ld /var/www/* | awk 'NR==1{print $3}')
echo "user hệ thống của site (chạy PHP): $SITEU"
sudo -u "$SITEU" cat /etc/tpan/secret.key >/dev/null 2>&1; echo "user site đọc secret.key: rc=$?"
sudo -u "$SITEU" cat /var/lib/tpan/tpan.db >/dev/null 2>&1; echo "user site đọc tpan.db: rc=$?"

say "5.2 DB và WAL (đang chạy)"
python3 /home/ubuntu/tps/scan.py "$L" /var/lib/tpan/tpan.db /var/lib/tpan/tpan.db-wal /var/lib/tpan/tpan.db-shm
echo "secret_enc có phải bản rõ? độ dài blob: $(sq "select user_name||'='||length(secret_enc) from user_totp" | tr '\n' ' ')"

say "5.3 journalctl -u tpan và /var/log"
journalctl -u tpan --no-pager -o cat >"$T/journal.txt" 2>&1; echo "journal tpan: $(wc -l <"$T/journal.txt") dòng"
journalctl --no-pager -o cat >"$T/journal-all.txt" 2>&1; echo "journal toàn máy: $(wc -l <"$T/journal-all.txt") dòng"
python3 /home/ubuntu/tps/scan.py "$L" "$T/journal.txt" "$T/journal-all.txt"
find /var/log -type f -size -200M >"$T/varlog.list"; echo "/var/log: $(wc -l <"$T/varlog.list") file"
python3 /home/ubuntu/tps/scan.py "$L" $(cat "$T/varlog.list") | grep -v ', trúng: 0$'

say "5.4 tpan backup create --all, quét bản sao tpan.db và mọi file backup mới"
touch "$T/mốc"
tpan backup create --all --yes >"$T/bk.out" 2>&1; echo "tpan backup create --all: rc=$?"; tail -3 "$T/bk.out" | mask
find / -xdev -newer "$T/mốc" -type f \( -name '*.db' -o -name '*.tar.gz' -o -name '*.sql*' -o -name '*.gz' -o -name '*.zst' \) 2>/dev/null | grep -v "^$T" >"$T/bk.list"
cat "$T/bk.list"
mkdir -p "$T/bkx"; for f in $(grep '\.tar\.gz$' "$T/bk.list"); do tar -xzf "$f" -C "$T/bkx" 2>/dev/null; done
for f in $(grep -E '\.gz$' "$T/bk.list" | grep -v '\.tar\.gz$'); do zcat "$f" >"$T/bkx/$(basename "$f").raw" 2>/dev/null; done
python3 /home/ubuntu/tps/scan.py "$L" $(grep -E '\.db$' "$T/bk.list") $(find "$T/bkx" -type f) | grep -v ', trúng: 0$'

say "5.5 MCP (tpan mcp qua stdin): initialize, tools/list, list_sites, list_jobs, get_job"
JOB=$(sq "select id from jobs where kind like 'db.%' order by rowid desc limit 1")
{
  echo '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"thu-pha","version":"0"}}}'
  echo '{"jsonrpc":"2.0","method":"notifications/initialized"}'
  echo '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'
  echo '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"list_sites","arguments":{}}}'
  echo '{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"list_jobs","arguments":{}}}'
  echo "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"get_job\",\"arguments\":{\"id\":\"$JOB\"}}}"
  sleep 3
} | timeout 20 tpan mcp >"$T/mcp.out" 2>"$T/mcp.err"
echo "mcp: $(wc -l <"$T/mcp.out") dòng; công cụ: $(grep '"id":2' "$T/mcp.out" | jq -r '[.result.tools[].name]|join(",")' 2>/dev/null)"
grep -o '"isError":[a-z]*' "$T/mcp.out" | sort | uniq -c
python3 /home/ubuntu/tps/scan.py "$L" "$T/mcp.out" "$T/mcp.err"

say "5.6 câu trả lời API (không phải lần hiện đầu tiên)"
login s5 admin2 >/dev/null
for p in /api/v1/account/2fa /api/v1/account/tokens /api/v1/tokens /api/v1/settings/auth /api/v1/users /api/v1/users/khach /api/v1/users/vic \
  /api/v1/jobs "/api/v1/jobs/$JOB" /api/v1/export /api/v1/overview /api/v1/session /api/v1/account/sessions /api/v1/databases /api/v1/panel; do
  c s5 GET "$p" >/dev/null; cp "$T/body" "$T/api.$(echo "$p" | tr '/?' '__')"; echo "GET $p -> $(code)"
done
curl -sk -N --max-time 4 -b "$T/s5" "$B/api/v1/jobs/$JOB/events" >"$T/api._events" 2>/dev/null
python3 /home/ubuntu/tps/scan.py "$L" "$T"/api.* "$T/job.secondread" 2>/dev/null | grep -v ', trúng: 0$'

say "5.7 audit: có dòng nào mang mã/bí mật trong target/result? (đếm theo cột)"
sq "select action, count(*) from audit where action like '%2fa%' or action like 'token%' or action like 'login%' group by 1" | head -20
sq -separator ' ' "select * from audit" >"$T/audit.txt"; python3 /home/ubuntu/tps/scan.py "$L" "$T/audit.txt"

