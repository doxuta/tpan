######## t3.sh
#!/usr/bin/env bash
# t3: nâng quyền bằng token, header Authorization lạ, CSRF, mật khẩu hiện một lần của job.
. /home/ubuntu/tps/lib.sh
mk() { # mk <tên biến> <user> <scope> : tạo token bằng CLI, giữ ở $T/tk.<biến>
  tpan token create "$2" --name "$1" --scope "$3" --days 30 --yes --json >"$T/tkc.$1" 2>&1
  local rc=$?
  jq -r '.token // empty' "$T/tkc.$1" >"$T/tk.$1"
  keep "$(cat "$T/tk.$1")"
  echo "token $1 ($2, $3): rc=$rc, khoá JSON: $(jq -c 'keys' "$T/tkc.$1" 2>/dev/null || head -c 200 "$T/tkc.$1" | mask)"
}
tc() { # tc <biến token> <METHOD> <path> [curl args]
  local t=$1 m=$2 p=$3
  shift 3
  printf 'Authorization: Bearer %s' "$(cat "$T/tk.$t")" >"$T/h.auth"
  curl -sk -o "$T/body" -w '%{http_code}' -H @"$T/h.auth" -X "$m" "$@" "$B$p" >"$T/code"
  printf '[tk %s] %s %s -> HTTP %s %s\n' "$t" "$m" "$p" "$(code)" "$(head -c 200 "$T/body" | tr '\n' ' ')" | mask
}
U="user khach (vai user)"
say "3.0 tạo token bằng CLI"
mk K khach sites:write,databases:write,backups:write,cron:write,jobs:write,health:write,ssl:write
mk K2 khach jobs:read,sites:read
mk KR khach sites:read
mk A2 admin2 system:read,sites:write
mk V2 vic2 sites:read
tpan token create khach --name KS --scope system:read --days 30 --yes 2>&1 | tail -2 | mask
echo "(user thường xin nhóm system bằng CLI)"
tpan token create khach --name KD --scope sites:read --days 5000 --yes 2>&1 | tail -2 | mask
echo "(quá trần ngày)"

say "3.1 token của $U gọi route admin và route chỉ phiên"
for p in /api/v1/stack /api/v1/machine /api/v1/security /api/v1/panel /api/v1/self /api/v1/updates /api/v1/cage /api/v1/usage/suggestions \
  /api/v1/users /api/v1/tokens /api/v1/settings/auth /api/v1/plans /api/v1/ai/brain /api/v1/backups/target \
  /api/v1/account/tokens /api/v1/account/2fa /api/v1/account/sessions /api/v1/sites/a.example.com /api/v1/sites; do
  tc K GET "$p"
done
tc K POST /api/v1/ssl/settings -H 'Content-Type: application/json' --data '{}'
tc K POST /api/v1/backups/settings -H 'Content-Type: application/json' --data '{}'
tc K POST /api/v1/panel/domain -H 'Content-Type: application/json' --data '{"domain":"x.example.com"}'
tc K POST /api/v1/users/khach/view-as -H 'Content-Type: application/json' --data '{}'
tc K POST /api/v1/session/view-as/exit -H 'Content-Type: application/json' --data '{}'
tc K POST /api/v1/account/password -H 'Content-Type: application/json' --data '{}'
tc K POST /api/v1/account/tokens -H 'Content-Type: application/json' --data '{"name":"x","scopes":["sites:read"],"days":1}'
tc K POST /api/v1/account/2fa/disable -H 'Content-Type: application/json' --data '{}'
tc K DELETE /api/v1/sites/a.example.com
tc K POST /api/v1/sites/a.example.com/backups -H 'Content-Type: application/json' --data '{}'
tc K GET /api/v1/overview?refresh=1

say "3.2 token thiếu phạm vi"
tc KR POST /api/v1/sites -H 'Content-Type: application/json' --data '{"domain":"z.example.com"}'
tc KR GET /api/v1/databases
tc KR GET /api/v1/jobs
tc KR HEAD /api/v1/sites
tc KR OPTIONS /api/v1/sites
tc K2 POST /api/v1/sites -H 'Content-Type: application/json' --data '{"domain":"z.example.com"}'

say "3.3 header Authorization lạ (route GET /api/v1/sites, token K)"
TK=$(cat "$T/tk.K")
v() { curl -sk -o "$T/body" -w '%{http_code}' "$@" "$B/api/v1/sites" >"$T/code"; printf '%s -> HTTP %s %s\n' "$LBL" "$(code)" "$(head -c 90 "$T/body")" | mask; }
LBL='Bearer <tk>' v -H "Authorization: Bearer $TK"
LBL='bearer <tk>' v -H "Authorization: bearer $TK"
LBL='BEARER <tk>' v -H "Authorization: BEARER $TK"
LBL='Bearer  <tk> (2 dấu cách)' v -H "Authorization: Bearer  $TK"
LBL='Bearer <tk><TAB>' v -H "Authorization: Bearer $TK	"
LBL='Bearer<TAB><tk>' v -H "Authorization: Bearer	$TK"
LBL='authorization (chữ thường) Bearer <tk>' v -H "authorization: Bearer $TK"
LBL='hai header Bearer <tk>' v -H "Authorization: Bearer $TK" -H "Authorization: Bearer $TK"
LBL='Bearer <tk>, Bearer <tk> (một header)' v -H "Authorization: Bearer $TK, Bearer $TK"
LBL='Basic <base64>' v -H "Authorization: Basic $(printf 'khach:%s' "$(cat "$T/pw.khach")" | base64 -w0)"
LBL='Bearer <tk thiếu 1 ký tự>' v -H "Authorization: Bearer ${TK%?}"
LBL='Bearer <tk đổi ký tự cuối>' v -H "Authorization: Bearer ${TK%?}A"
LBL='Bearer <tk> trong query ?access_token=' curl -sk -o "$T/body" -w '%{http_code}' "$B/api/v1/sites?access_token=$TK" >"$T/code"; echo "?access_token=<tk> -> HTTP $(code) $(head -c 90 "$T/body")" | mask
LBL='X-Authorization: Bearer <tk>' v -H "X-Authorization: Bearer $TK"
# phiên admin + header
login adm admin2
LBL='cookie phiên admin2 + Authorization rỗng -> GET /sites' v -b "$T/adm" -H 'Authorization;'
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/adm" -H "Authorization: Bearer $TK" "$B/api/v1/stack" >"$T/code"
echo "cookie phiên admin2 + token khach -> GET /stack: HTTP $(code) $(head -c 90 "$T/body")" | mask
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/adm" -H "Authorization: Bearer x" "$B/api/v1/stack" >"$T/code"
echo "cookie phiên admin2 + 'Bearer x' -> GET /stack: HTTP $(code) $(head -c 90 "$T/body")" | mask
c adm GET /api/v1/stack >/dev/null; echo "phiên admin2 vẫn sống sau các lần trên: GET /stack HTTP $(code)"

say "3.4 CSRF: phiên admin2, POST đổi trạng thái từ origin lạ"
for h in 'Origin: https://evil.example.com' 'Origin: null' 'Sec-Fetch-Site: cross-site' 'Sec-Fetch-Site: same-site' 'Origin: https://127.0.0.1:8444'; do
  curl -sk -o "$T/body" -w '%{http_code}' -b "$T/adm" -H "$h" -H 'Content-Type: application/json' --data '{"name":"csrf1","role":"admin"}' "$B/api/v1/users" >"$T/code"
  echo "POST /users với '$h' -> HTTP $(code) $(head -c 90 "$T/body")" | mask
done
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/adm" -H 'Origin: https://evil.example.com' -H 'Content-Type: text/plain' --data '{"name":"khach","password":"x"}' "$B/api/v1/login" >"$T/code"
echo "POST /login (login CSRF) từ evil, text/plain -> HTTP $(code) $(head -c 90 "$T/body")" | mask
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/adm" -H 'Sec-Fetch-Site: cross-site' -X GET "$B/api/v1/session/view-as/exit" >"$T/code"
echo "GET (không phải POST) route ghi view-as/exit cross-site -> HTTP $(code) $(head -c 90 "$T/body")" | mask
curl -sk -o "$T/body" -w '%{http_code}' -H "Authorization: Bearer $TK" -H 'Origin: https://evil.example.com' -H 'Content-Type: application/json' --data '{}' "$B/api/v1/sites" >"$T/code"
echo "token + Origin lạ POST /sites -> HTTP $(code) $(head -c 90 "$T/body") (token không gửi tự động nên CSRF không áp; chỉ ghi nhận)" | mask

say "3.5 mật khẩu hiện một lần của job (DB password của k.example.org)"
tc K POST /api/v1/databases/k.example.org/password -H 'Content-Type: application/json' --data '{}'
JOB=$(jq -r '.job_id // .id // .job.id // empty' "$T/body"); echo "job: $JOB"
sleep 8
tc K2 GET "/api/v1/jobs/$JOB"
echo "khoá có mật khẩu trong câu trả lời cho token khác (K2): $(jq -c '[paths|join(".")|select(test("secret"))]' "$T/body")"
curl -sk -N --max-time 4 -o "$T/sse.K2" -H @<(printf 'Authorization: Bearer %s' "$(cat "$T/tk.K2")") "$B/api/v1/jobs/$JOB/events"
echo "SSE events cho K2: $(wc -c <"$T/sse.K2") byte, có chữ secret: $(grep -c -i secret "$T/sse.K2")"
login ks khach >/dev/null
echo "(phiên khach cần bước hai; dùng mã)"; wait_fresh; codejson "$(totp khach)"; c ks POST /api/v1/login/2fa -H 'Content-Type: application/json' --data-binary @"$T/req.code"
c ks GET "/api/v1/jobs/$JOB" >/dev/null
echo "phiên khach GET job do token khởi: HTTP $(code), khoá secret: $(jq -c '[paths|join(".")|select(test("secret"))]' "$T/body")"
tc K GET "/api/v1/jobs/$JOB" >/dev/null
echo "token K (người khởi) GET job: HTTP $(code), khoá secret: $(jq -c '[paths|join(".")|select(test("secret"))]' "$T/body")"
jq -r '.. | objects | (.secret?, .db_secret?, (.secrets? // empty | .[]?)) // empty | strings' "$T/body" 2>/dev/null | while read -r x; do keep "$x"; done
tc K GET "/api/v1/jobs/$JOB" >/dev/null
echo "token K lần hai: khoá secret: $(jq -c '[paths|join(".")|select(test("secret"))]' "$T/body")"
cp "$T/body" "$T/job.secondread"

