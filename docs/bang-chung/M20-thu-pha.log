######## t6.sh (pebble; lần chạy này bị ngắt giữa phần 6.5 khi phiên bị tắt, phần còn lại làm ở t7)
#!/usr/bin/env bash
# t6: chứng chỉ panel (pebble): tên panel trùng site, site trùng tên panel, đua đặt tên với tạo site,
# xoá/đổi tên rồi xem SNI còn được phục vụ chứng chỉ cũ không.
. /home/ubuntu/tps/lib.sh
issuer() { # issuer <SNI>: issuer và SAN của chứng chỉ cổng 8443 cho SNI
  echo | timeout 8 openssl s_client -connect 127.0.0.1:8443 -servername "$1" 2>/dev/null |
    openssl x509 -noout -issuer -ext subjectAltName 2>/dev/null | tr '\n' ' ' | sed 's/X509v3 Subject Alternative Name: *//'
  echo
}
say "6.0 dựng pebble và tên trong /etc/hosts (chỉ máy ảo)"
bash /home/ubuntu/tps/pebble.sh /etc/tpan-thu-pebble tpan-thu-pebble 2>&1 | tail -3
for n in panel.m20.test panel2.m20.test race.m20.test k.example.org a.example.com; do grep -q " $n\$" /etc/hosts || echo "127.0.0.1 $n" >>/etc/hosts; done
tpan ssl settings --email admin@example.com --server https://localhost:14000/dir 2>&1 | tail -1
echo "SNI panel.m20.test trước khi đặt: $(issuer panel.m20.test)"

say "6.1 đặt tên panel trùng tên site (và biến thể)"
for d in k.example.org K.EXAMPLE.ORG k.example.org. ; do
  tpan panel domain set "$d" --yes >"$T/pd.out" 2>&1; echo "tpan panel domain set '$d': rc=$? $(grep -m1 -iE 'từ chối|lỗi|error|refus' "$T/pd.out" | head -c 200)"
done

say "6.2 đặt panel.m20.test (pebble), rồi tạo site trùng tên panel (API của khach và CLI)"
tpan panel domain set panel.m20.test --yes >"$T/pd.out" 2>&1; echo "set panel.m20.test: rc=$? $(tail -1 "$T/pd.out")"
sleep 3
echo "SNI panel.m20.test: $(issuer panel.m20.test)"
echo "SNI PANEL.M20.TEST (chữ hoa): $(issuer PANEL.M20.TEST)"
echo "SNI k.example.org trên 8443: $(issuer k.example.org)"
echo "không SNI (IP): $(echo | timeout 8 openssl s_client -connect 127.0.0.1:8443 -noservername 2>/dev/null | openssl x509 -noout -issuer)"
login ks2 khach >/dev/null; echo "(khach có hai bước)"; wait_fresh; codejson "$(totp khach)"; c ks2 POST /api/v1/login/2fa -H 'Content-Type: application/json' --data-binary @"$T/req.code"
for d in panel.m20.test PANEL.M20.TEST panel.m20.test. ; do
  c ks2 POST /api/v1/sites -H 'Content-Type: application/json' --data "{\"domain\":\"$d\",\"email\":\"admin@example.com\"}"
done
tpan site add panel.m20.test --email admin@example.com --yes 2>&1 | grep -m1 -iE 'từ chối|lỗi' | head -c 200; echo

say "6.3 Host là tên site tới cổng panel (421), cookie phiên bị huỷ"
login h1 admin2 >/dev/null
curl -sk -o "$T/body" -w '%{http_code}' -b "$T/h1" --resolve k.example.org:8443:127.0.0.1 https://k.example.org:8443/api/v1/sites >"$T/code"
echo "Host k.example.org + cookie phiên (đặt ở 127.0.0.1) -> HTTP $(code) $(head -c 120 "$T/body")" | mask
c h1 GET /api/v1/sites >/dev/null; echo "phiên đó sau lần trên (Host 127.0.0.1): HTTP $(code)"
for h in 'K.Example.Org' 'k.example.org.' 'k.example.org:443'; do
  curl -sk -o "$T/body" -w '%{http_code}' -H "Host: $h" "$B/api/v1/session" >"$T/code"; echo "Host '$h' -> HTTP $(code)"
done
curl -sk -o "$T/body" -w '%{http_code}' -H 'Host: k.example.org' -H 'Authorization: Bearer x' "$B/api/v1/session" >"$T/code"; echo "Host site + Authorization (miễn 421) GET /session -> HTTP $(code) $(head -c 80 "$T/body")"
printf '{"name":"admin2","password":"%s"}' "$(cat "$T/pw.admin2")" >"$T/req.login"
curl -sk -D "$T/hdr" -o "$T/body" -w '%{http_code}' -H 'Host: k.example.org' -H 'Authorization: Bearer x' -H 'Content-Type: application/json' --data-binary @"$T/req.login" "$B/api/v1/login" >"$T/code"
echo "Host site + Authorization giả, POST /login đúng mật khẩu -> HTTP $(code) $(head -c 100 "$T/body"); set-cookie: $(grep -ci '^set-cookie' "$T/hdr")"

say "6.4 xoá tên panel (--clear) và đổi tên: SNI tên cũ còn chứng chỉ pebble không?"
tpan panel domain set panel2.m20.test --yes >"$T/pd.out" 2>&1; echo "set panel2.m20.test: rc=$? $(tail -1 "$T/pd.out")"
sleep 3
echo "SNI panel2.m20.test: $(issuer panel2.m20.test)"
echo "SNI panel.m20.test (tên cũ): $(issuer panel.m20.test)"
echo "lineage trên đĩa: $(ls /etc/letsencrypt/live/ 2>/dev/null | tr '\n' ' ')"
tpan panel domain set --clear --yes >"$T/pd.out" 2>&1; echo "--clear: rc=$? $(tail -1 "$T/pd.out")"
sleep 3
echo "SNI panel2.m20.test sau --clear: $(issuer panel2.m20.test)"
echo "SNI panel.m20.test sau --clear: $(issuer panel.m20.test)"

say "6.5 đua: tpan panel domain set race.m20.test song song với API tạo site race.m20.test (admin2)"
login r1 admin2 >/dev/null
