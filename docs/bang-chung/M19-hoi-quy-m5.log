print("số job trong tpan.db:", n)
if len(sys.argv) > 1:
    j = c.execute("SELECT id, status FROM jobs WHERE kind = ? ORDER BY started_at DESC, rowid DESC LIMIT 1", (sys.argv[1],)).fetchone()
