    $ systemctl try-restart tpan-cage-tpan_probe_a_ec2_39a08a-php.service
    tạo /etc/systemd/system/tpan-tpan_probe_a_ec2_39a08a.slice
    tạo /etc/systemd/system/tpan-cage-tpan_probe_a_ec2_39a08a-php.socket
    tạo /etc/systemd/system/tpan-cage-tpan_probe_a_ec2_39a08a-php.service
    tạo /etc/systemd/system/tpan-cage-tpan_probe_a_ec2_39a08a-.service.d/fence.conf
