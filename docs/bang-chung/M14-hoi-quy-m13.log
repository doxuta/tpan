code=$(curl -sk -m 20 --resolve "$d:$port:127.0.0.1" -o "$f" -w "%{http_code}" "$scheme://$d$path"); rc=$?
echo "$scheme://$d$path curl=$rc http=$code marker=$(grep -c tpan-suspended-page "$f") title=$(grep -o "<title>[^<]*</title>" "$f" | head -1)"
rm -f "$f"
