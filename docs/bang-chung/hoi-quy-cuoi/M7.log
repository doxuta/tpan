      {
        "done": false,
        "info": {
          "commands": [
            "nginx -t",
            "systemctl reload nginx"
          ],
          "files": [
            {
              "new": "# Do tpan quản lý. Sửa tay sẽ bị tpan health báo lệch.\n#\n# Vhost Nginx của site site-b.example. Bản này chỉ nghe cổng 80; cổng 443 thêm ở mốc SSL.\nserver {\n    # Không có default_server: request không khớp tên nào rơi vào tpan-default.\n    listen 80;\n    listen [::]:80;\n    server_name site-b.example;\n\n    root /var/www/site-b.example/public;\n    index index.php;\n\n    # Log riêng từng site, trong thư mục mà /etc/logrotate.d/tpan-sites xoay vòng.\n    access_log /var/log/tpan/sites/site-b.example/access.log;\n    error_log /var/log/tpan/sites/site-b.example/error.log;\n\n    # Giới hạn upload 64 MB (pool PHP đặt cùng mức).\n    client_max_body_size 64m;\n\n    # Thử thách Let's Encrypt đọc từ webroot chung, không từ mã nguồn site.\n    # ^~: khớp tiền tố này thì Nginx không xét các location regex bên dưới.\n    location ^~ /.well-known/acme-challenge/ {\n        root /var/lib/tpan/acme;\n    }\n\n    # Các location regex được xét theo thứ tự trong file, cái khớp đầu tiên\n    # thắng, nên hai luật chặn phải đứng trước location của PHP.\n\n    # Chặn file và thư mục ẩn (.git, .env, .htaccess...), trừ .well-known.\n    location ~ /\\.(?!well-known/) {\n        deny all;\n    }\n\n    # Không chạy PHP trong thư mục upload: file .php ai đó tải lên được (qua lỗi\n    # của plugin) cũng không thành mã chạy được.\n    location ~* ^/wp-content/uploads/.*\\.php$ {\n        deny all;\n    }\n\n    # Permalink của WordPress: không có file hay thư mục đúng tên thì chuyển cho index.php.\n    location / {\n        try_files $uri $uri/ /index.php?$args;\n    }\n\n    location ~ \\.php$ {\n        # Chỉ chuyển cho PHP file .php có thật. Không có dòng này thì\n        # /uploads/anh.jpg/x.php có thể khiến PHP chạy anh.jpg như mã.\n        try_files $uri =404;\n        # fastcgi.conf của Ubuntu chính là fastcgi_params cộng dòng SCRIPT_FILENAME\n        # này. Gói nginx của nginx.org không có fastcgi.conf, nên ghi rõ cả hai để\n        # vhost chạy được với cả hai gói.\n        include fastcgi_params;\n        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;\n        fastcgi_pass unix:/run/php/tpan-site_b-8.3.sock;\n    }\n}\n",
              "old_exists": false,
              "path": "/etc/nginx/sites-available/tpan-site-b.example.conf"
            }
          ],
          "id": "file:/etc/nginx/sites-available/tpan-site-b.example.conf",
          "title": {
            "en": "Write nginx vhost for site-b.example",
            "vi": "Ghi vhost nginx cho site-b.example"
          },
          "why": {
            "en": "The vhost tells nginx where to find files for site-b.example and which pool gets its .php requests. Without it requests fall into tpan's default site (444 or 403).",
            "vi": "Vhost nói cho nginx biết request tới site-b.example lấy file ở đâu và chuyển .php cho pool nào. Thiếu nó thì request rơi vào site mặc định của tpan (444 hoặc 403)."
          }
