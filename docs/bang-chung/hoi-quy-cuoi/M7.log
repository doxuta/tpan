    $ runuser -u tp_b_example_com_cd59d5 -- wp core install --url=http://b.example.com --title=b.example.com --admin_user=admin --admin_email=admin@example.com --prompt=admin_password --skip-email --quiet --path=/var/www/b.example.com/public
    $ runuser -u tp_b_example_com_cd59d5 -- wp rewrite structure /%postname%/ --quiet --path=/var/www/b.example.com/public
