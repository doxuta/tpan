    $ curl -fsSL --proto =https --max-time 60 -o /tmp/tpan-apt-key.XXXXXXXX/key https://mariadb.org/mariadb_release_signing_key.pgp
    $ gpg --homedir /tmp/tpan-apt-key.XXXXXXXX --batch --no-default-keyring --keyring /tmp/tpan-apt-key.XXXXXXXX/k.kbx --import /tmp/tpan-apt-key.XXXXXXXX/key
    $ gpg --homedir /tmp/tpan-apt-key.XXXXXXXX --batch --no-default-keyring --keyring /tmp/tpan-apt-key.XXXXXXXX/k.kbx --yes --output /tmp/tpan-apt-key.XXXXXXXX/export.gpg --export 177F4010FE56CA3336300305F1656F24C74CD1D8  # → /etc/apt/keyrings/tpan-mariadb.gpg
