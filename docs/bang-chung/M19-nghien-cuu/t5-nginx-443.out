== SAN thử:  DNS:example.com, DNS:www.example.com, DNS:xn--vitnam-jk8b.example.net
== vhost (bỏ chú thích): server_name và đích
8:    listen 80;
9:    listen [::]:80;
10:    server_name example.com;
26:        return 301 https://example.com$request_uri;
31:    # "ssl" ở dòng listen là cách bật TLS của Nginx 1.24 (Ubuntu 24.04). Không
34:    listen 443 ssl;
35:    listen [::]:443 ssl;
36:    server_name example.com xn--vitnam-jk8b.example.net;
38:    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
102:    listen 80;
103:    listen [::]:80;
104:    server_name www.example.com uncovered.example.net;
114:        return 301 https://example.com$request_uri;
121:    listen 80;
122:    listen [::]:80;
123:    server_name xn--vitnam-jk8b.example.net;
133:        return 301 https://xn--vitnam-jk8b.example.net$request_uri;
138:    listen 443 ssl;
139:    listen [::]:443 ssl;
140:    server_name www.example.com;
142:    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
149:        return 301 https://example.com$request_uri;
