mã 0
== apache2ctl -S (tên và tên phụ)
*:80                   is a NameVirtualHost
         port 80 namevhost tpan-default.invalid (/etc/apache2/sites-enabled/000-tpan-default.conf:7)
         port 80 namevhost example.com (/etc/apache2/sites-enabled/tpan-example.com.conf:5)
                 alias xn--vitnam-jk8b.example.net
         port 80 namevhost www.example.com (/etc/apache2/sites-enabled/tpan-example.com.conf:107)
== tên chính, tên phụ phục vụ, tên phụ chuyển
N01 tên chính /                  curl=0 200 loc= body=[<!DOCTYPE html><html lang="en-US"><head>.<meta charset="U]
N02 tên phụ phục vụ (punycode) / curl=0 200 loc= body=[<!DOCTYPE html><html lang="en-US"><head>.<meta charset="U]
N03 tên phụ chuyển /          curl=0 301 loc=http://example.com/ body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
N04 tên phụ chuyển /a?b=1     curl=0 301 loc=http://example.com/a?b=1 body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
N05 tên phụ chuyển: thử thách curl=0 200 loc= body=[t2-acme-ok]
N06 tên chính: thử thách      curl=0 200 loc= body=[t2-acme-ok]
== luật chuyển hướng theo đường dẫn
P01 /old-page                      curl=0 301 loc=http://example.com/new-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P02 /old-page?x=1 (giữ query?)   curl=0 301 loc=http://example.com/new-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P03 /old-page/ (không khớp)     curl=0 302 loc=http://example.com/from-htaccess/ body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P04 /OLD-PAGE (không khớp)      curl=0 404 loc= body=[<!DOCTYPE html><html lang="en-US"><head>.<meta charset="U]
P05 //old-page (gộp gạch chéo) curl=0 301 loc=http://example.com/new-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P06 /old%2Dpage (mã hoá %)       curl=0 301 loc=http://example.com/new-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P07 /keepq?a=1&b=2                 curl=0 301 loc=https://example.net/target?a=1&b=2 body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P08 /keepq (không query)          curl=0 301 loc=https://example.net/target body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P09 /dropq?a=1                     curl=0 302 loc=https://example.net/target body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P10 /old-page qua tên phụ phục vụ curl=0 301 loc=http://xn--vitnam-jk8b.example.net/new-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
P11 /old-page qua tên phụ chuyển curl=0 301 loc=http://example.com/old-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
== luật chặn có sẵn vẫn đứng
S01 uploads/evil.php (chặn)      curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
S02 uploads/evil2.php (có luật =) curl=0 301 loc=http://example.com/moved body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
S03 /.env (chặn file ẩn)       curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
S04 tên phụ phục vụ: evil.php curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
S05 .htaccess: /ht-only            curl=0 302 loc=http://example.com/from-htaccess body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
S06 .htaccess+vhost: /old-page     curl=0 301 loc=http://example.com/new-page body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
== bộ định tuyến dựng lại R01-R14 (cho tên phụ)
R01 hoa: WWW.EXAMPLE.COM           curl=0 301 loc=http://example.com/ body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R02 hoa: XN--VITNAM-JK8B.EXAMPLE.NET curl=0 200 loc= body=[<!DOCTYPE html><html lang="en-US"><head>.<meta charset="U]
R03 chấm cuối: www.example.com. curl=0 301 loc=http://example.com/ body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R04 chấm cuối: punycode.       curl=0 200 loc= body=[<!DOCTYPE html><html lang="en-US"><head>.<meta charset="U]
R05 cổng: www.example.com:80     curl=0 301 loc=http://example.com/ body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R06 cổng lạ: www.example.com:8080 curl=0 301 loc=http://example.com/ body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R07 Unicode thô trong Host        curl=0 400 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R08 Host lạ: evil.example.org    curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R09 Host là IP 127.0.0.1          curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R10 Host rỗng                    curl=0 400 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R11 Host dài 300 ký tự         curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R12 tên con chưa khai: x.www.example.com curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R13 dòng yêu cầu dạng URI tuyệt đối, Host khác curl=0 403 loc= body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
R14 URI tuyệt đối trỏ tên phụ, Host lạ curl=0 301 loc=http://example.com/x body=[<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN"><html><he]
