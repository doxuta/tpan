[2026-11-20 22:35:34] $ scripts/vm.sh exec cat /etc/logrotate.d/tpan-sites
# Do tpan quản lý. Sửa tay sẽ bị tpan health báo lệch.
#
# Xoay vòng log của các site do tpan quản lý: /var/log/tpan/sites/<domain>/*.log
# Giữ 14 bản theo ngày, nén lại, để log không ăn hết đĩa.
#
# Không dùng chỉ thị su: thư mục log của mỗi site thuộc root:<nhóm của site>,
# quyền 0750 (mục 5): chủ là root và nhóm chỉ được đọc, nên logrotate chạy bằng
# root không phải đổi tên file trong một thư mục do user của site kiểm soát.
# Nếu user của site ghi được vào thư mục, nó có thể đặt symlink để lừa root ghi
# đè file khác. Nhóm của site (thay cho "ai cũng đọc được") để site này không
# đọc được log của site khác.

# access.log và error.log do Nginx ghi: xoay xong phải báo cho nó mở lại
# file mới, không thì nó cứ ghi vào file cũ đã đổi tên.
/var/log/tpan/sites/*/access.log /var/log/tpan/sites/*/error.log {
    daily
    rotate 14
    # Site mới chưa có log, hoặc log rỗng: bỏ qua thay vì báo lỗi hay tạo bản rỗng.
    missingok
    notifempty
    compress
    # Chưa nén bản vừa xoay: web server có thể còn ghi dở vào nó cho tới khi
    # mở lại file; nén ở lần xoay sau.
    delaycompress
    # Tạo file mới cùng chủ và quyền với file cũ.
    create
    # Một lần postrotate cho tất cả site, không phải mỗi site một lần.
    sharedscripts
    postrotate
        # Gửi HUP cho tiến trình chính của Nginx: nó chạy bằng root, mở file
        # log mới rồi sinh worker mới thừa kế file đã mở; worker cũ làm nốt
        # request đang chạy rồi thoát, không ngắt kết nối nào.
        # Không dùng USR1 (tín hiệu "mở lại log" quen thuộc): nhận USR1, từng
        # worker (chạy dưới www-data) tự mở lại file theo đường dẫn, mà thư mục
        # log là root:<nhóm của site> 0750 nên worker bị từ chối ở thư mục và
        # log mới vẫn rơi vào access.log.1 (đã đo trên máy ảo).
        # HUP cũng là nạp lại cấu hình: nếu cấu hình Nginx đang sai cú pháp thì
        # Nginx giữ worker cũ và log chưa được mở lại cho tới lần reload đúng.
        # Không gọi init script của gói Ubuntu (gói của nginx.org không có); cả
        # hai gói đều ghi /run/nginx.pid. Chưa có file pid (Nginx chưa chạy)
        # thì bỏ qua, không báo lỗi.
        [ ! -f /run/nginx.pid ] || kill -HUP "$(cat /run/nginx.pid)"
    endscript
}

# php-error.log do PHP-FPM ghi, dưới user của site. copytruncate: chép nội dung
# sang file mới rồi cắt file gốc về 0, nên PHP-FPM không cần biết gì và không
# cần reload. Đổi lại có thể mất vài dòng ghi đúng lúc cắt; log lỗi PHP chấp
# nhận được. File gốc giữ nguyên chủ (user của site) nên PHP vẫn ghi được.
/var/log/tpan/sites/*/php-error.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    copytruncate
}
