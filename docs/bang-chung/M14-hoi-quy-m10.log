        a = rows[i - 1][0] + rows[i - 1][3] if i > 0 else rows[i][0]
        b = rows[k][0] + rows[k][3] if k < len(rows) else rows[k - 1][0] + rows[k - 1][3]
        outs.append((b - a, a, b, k - i))
        i = k
