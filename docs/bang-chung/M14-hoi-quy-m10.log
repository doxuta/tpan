import sqlite3, datetime
def t(s):
    a, _, b = s.rstrip("Z").partition(".")
    return datetime.datetime.fromisoformat(a + "." + (b[:6] or "0"))
c = sqlite3.connect("file:/var/lib/tpan/tpan.db?mode=ro", uri=True)
