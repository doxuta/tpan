if len(sys.argv) < 2:
    sys.exit(0)
j = c.execute("SELECT id, status, target, started_at, finished_at, error FROM jobs WHERE kind = ? ORDER BY started_at DESC, rowid DESC LIMIT 1", (sys.argv[1],)).fetchone()
if j is None:
    print("không có job", sys.argv[1])
    sys.exit(0)
