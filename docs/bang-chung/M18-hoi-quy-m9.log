print("bắt đầu:", j[3], "| xong:", j[4])
try:
    p = lambda s: datetime.datetime.fromisoformat(s.replace("Z", "+00:00"))
    print("thời gian job: %.1f giây" % (p(j[4]) - p(j[3])).total_seconds())
except Exception as e:
