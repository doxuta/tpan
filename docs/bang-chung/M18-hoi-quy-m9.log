for kind, step, msg in c.execute("SELECT kind, step_id, message FROM job_events WHERE job_id = ? AND kind IN (\"command\", \"step.fail\", \"undo.done\", \"undo.fail\") ORDER BY seq", (j[0],)):
    print(" ", kind, step or "-", msg[:300].replace("\n", " "))
