            "find /var/www/site-c.example/public -mindepth 1 -type d -exec chmod 2750 '{}' +",
            "runuser -u tp_site_c -- find /var/www/site-c.example/public -mindepth 1 -type f -exec chmod 0640 '{}' +"
          ],
          "id": "wp.files:site-c.example",
          "title": {
            "en": "Extract WordPress into /var/www/site-c.example/public",
            "vi": "Giải nén WordPress vào /var/www/site-c.example/public"
          },
          "why": {
            "en": "This is the site's code. Without it the web server has nothing to run. Directories 2750 and files 0640 let the web server read static files through the www-data group, while other sites cannot read them.",
            "vi": "Đây là mã nguồn của site. Thiếu nó thì web server không có gì để chạy. Quyền thư mục 2750 và file 0640 cho web server đọc file tĩnh qua nhóm www-data, còn site khác thì không đọc được."
          }
        }
      },
      {
        "done": false,
        "info": {
          "commands": [
            "runuser -u tp_site_c -- wp config create --dbname=tp_site_c --dbuser=tp_site_c --dbhost=localhost --dbcharset=utf8mb4 --prompt=dbpass --quiet --path=/var/www/site-c.example/public",
            "runuser -u tp_site_c -- wp config set DISALLOW_FILE_EDIT true --raw --type=constant --quiet --path=/var/www/site-c.example/public",
            "runuser -u tp_site_c -- chmod 0600 -- /var/www/site-c.example/public/wp-config.php"
          ],
          "id": "wp.config:site-c.example",
          "title": {
            "en": "Create /var/www/site-c.example/public/wp-config.php",
            "vi": "Tạo /var/www/site-c.example/public/wp-config.php"
          },
          "why": {
            "en": "WordPress reads the database name, user and password from this file. Without it the site shows the setup page and whoever arrives first takes the site. Mode 600 lets only the site's user read the database password, not the web server or other sites.",
            "vi": "WordPress đọc tên DB, user DB và mật khẩu từ file này. Thiếu nó thì site chỉ hiện trang cài đặt, ai vào trước người đó chiếm site. Quyền 600 để chỉ user của site đọc được mật khẩu DB, web server và site khác thì không."
          }
        }
      },
      {
        "done": false,
        "info": {
          "commands": [
            "nginx -t",
            "systemctl reload nginx"
          ],
          "files": [
            {
              "new": "# Do tpan quản lý. Sửa tay sẽ bị tpan health báo lệch.\n#\n# Vhost Nginx của site site-c.example. Bản này chỉ nghe cổng 80; cổng 443 thêm ở mốc SSL.\nserver {\n    # Không có default_server: request không khớp tên nào rơi vào tpan-default.\n    listen 80;\n    listen [::]:80;\n    server_name site-c.example;\n\n    root /var/www/site-c.example/public;\n    index index.php;\n\n    # Log riêng từng site, trong thư mục mà /etc/logrotate.d/tpan-sites xoay vòng.\n    access_log /var/log/tpan/sites/site-c.example/access.log;\n    error_log /var/log/tpan/sites/site-c.example/error.log;\n\n    # Giới hạn upload 64 MB (pool PHP đặt cùng mức).\n    client_max_body_size 64m;\n\n    # Thử thách Let's Encrypt đọc từ webroot chung, không từ mã nguồn site.\n    # ^~: khớp tiền tố này thì Nginx không xét các location regex bên dưới.\n    location ^~ /.well-known/acme-challenge/ {\n        root /var/lib/tpan/acme;\n    }\n\n    # Các location regex được xét theo thứ tự trong file, cái khớp đầu tiên\n    # thắng, nên hai luật chặn phải đứng trước location của PHP.\n\n    # Chặn file và thư mục ẩn (.git, .env, .htaccess...), trừ .well-known.\n    location ~ /\\.(?!well-known/) {\n        deny all;\n    }\n\n    # Không chạy PHP trong thư mục upload: file .php ai đó tải lên được (qua lỗi\n    # của plugin) cũng không thành mã chạy được.\n    location ~* ^/wp-content/uploads/.*\\.php$ {\n        deny all;\n    }\n\n    # Permalink của WordPress: không có file hay thư mục đúng tên thì chuyển cho index.php.\n    location / {\n        try_files $uri $uri/ /index.php?$args;\n    }\n\n    location ~ \\.php$ {\n        # Chỉ chuyển cho PHP file .php có thật. Không có dòng này thì\n        # /uploads/anh.jpg/x.php có thể khiến PHP chạy anh.jpg như mã.\n        try_files $uri =404;\n        include fastcgi.conf;\n        fastcgi_pass unix:/run/php/tpan-site_c.sock;\n    }\n}\n",
              "old_exists": false,
              "path": "/etc/nginx/sites-available/tpan-site-c.example.conf"
            }
          ],
          "id": "file:/etc/nginx/sites-available/tpan-site-c.example.conf",
          "title": {
