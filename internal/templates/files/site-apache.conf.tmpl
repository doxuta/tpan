{{.Header}}
#
# Vhost Apache của site {{.Domain}}. Bản này chỉ nghe cổng 80; cổng 443 thêm ở mốc SSL.
# Apache chạy MPM event, PHP đi qua proxy_fcgi tới pool riêng của site (mục 3).
<VirtualHost *:80>
    ServerName {{.Domain}}
    DocumentRoot "{{.Public}}"
    DirectoryIndex index.php

    # Log riêng từng site, trong thư mục mà /etc/logrotate.d/tpan-sites xoay vòng.
    ErrorLog "{{.LogDir}}/error.log"
    CustomLog "{{.LogDir}}/access.log" combined

    # Giới hạn upload 64 MB (pool PHP đặt cùng mức). Đơn vị là byte.
    LimitRequestBody 67108864

    # Thử thách Let's Encrypt đọc từ webroot chung, không từ mã nguồn site.
    Alias /.well-known/acme-challenge/ "{{.AcmeRoot}}/.well-known/acme-challenge/"
    <Directory "{{.AcmeRoot}}/.well-known/acme-challenge">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    # Neo của site (thư mục chứa public). apache2.conf của Ubuntu đặt
    # "Options Indexes FollowSymLinks" cho cả /var/www, và Apache xét chính
    # thành phần public theo Options của thư mục chứa nó: thiếu khối này, site
    # đổi public thành symlink sang thư mục của site khác là Apache trả file
    # của site kia. Khối chỉ đổi Options, không cho thêm quyền truy cập nào.
    <Directory "{{.Dir}}">
        Options SymLinksIfOwnerMatch
        AllowOverride None
    </Directory>

    <Directory "{{.Public}}">
        # Ghi đè "Indexes FollowSymLinks" mà apache2.conf của Ubuntu đặt cho
        # /var/www: không liệt kê thư mục. Permalink (mod_rewrite trong
        # .htaccess) cần FollowSymLinks hoặc SymLinksIfOwnerMatch; chọn cái sau
        # để site này không đặt symlink trỏ sang file của site khác.
        Options SymLinksIfOwnerMatch
{{- template "site-apache-override.tmpl" .}}
        Require all granted
    </Directory>

    # Không chạy PHP trong thư mục upload: file .php ai đó tải lên được (qua lỗi
    # của plugin) cũng không thành mã chạy được. AllowOverride None để một
    # .htaccess đặt vào uploads/ không mở lại được.
    <Directory "{{.Public}}/wp-content/uploads">
        AllowOverride None
        <FilesMatch "(?i)\.php$">
            Require all denied
        </FilesMatch>
    </Directory>

    # Chặn file ẩn (.env, .htaccess, .user.ini...).
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    # Chặn thư mục ẩn (.git...), trừ .well-known.
    <DirectoryMatch "/\.(?!well-known(/|$))">
        Require all denied
    </DirectoryMatch>

    # PHP-FPM nhận hai biến PHP_VALUE và PHP_ADMIN_VALUE từ web server và cho
    # chúng đè cả php_admin_value của pool. Thiếu hai dòng dưới, .htaccess của
    # site chỉ cần một dòng SetEnv PHP_ADMIN_VALUE "open_basedir=/" là PHP của
    # nó đọc được ngoài thư mục site. Hai dòng này gỡ cả hai biến ngay trước
    # khi request được gửi sang PHP-FPM.
    ProxyFCGISetEnvIf "true" !PHP_VALUE
    ProxyFCGISetEnvIf "true" !PHP_ADMIN_VALUE

    # PHP chuyển tới pool riêng của site qua socket. Không khai báo khối
    # <Proxy "fcgi://localhost">: các site dùng chung tên này, khai báo worker
    # dùng lại kết nối thì các site sẽ dùng chung một worker.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:{{.Socket}}|fcgi://localhost"
    </FilesMatch>
</VirtualHost>
