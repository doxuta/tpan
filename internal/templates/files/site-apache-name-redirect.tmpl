{{/* Vhost chuyển tên phụ cổng 80 (M19, mục 3.4). Dòng trống đầu tách nó khỏi vhost trước. */}}
# Tên phụ chuyển về {{.To}} (M19, tpan site alias).
<VirtualHost *:80>
    ServerName {{.First}}
{{- if .Rest}}
    ServerAlias {{.Rest}}
{{- end}}
    DocumentRoot "{{.Public}}"

    ErrorLog "{{.LogDir}}/error.log"
    CustomLog "{{.LogDir}}/access.log" combined

    Alias /.well-known/acme-challenge/ "{{.AcmeRoot}}/.well-known/acme-challenge/"
    <Directory "{{.AcmeRoot}}/.well-known/acme-challenge">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    <Directory "{{.Dir}}">
        Options SymLinksIfOwnerMatch
        AllowOverride None
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^/(.*)$ {{.To}}/$1 [R=301,L]
</VirtualHost>
