# Do tpan quản lý. Sửa tay sẽ bị tpan health báo lệch.
#
# .htaccess chuẩn của WordPress (bản "Basic WP" trong tài liệu của WordPress).
# Không có file hay thư mục đúng tên thì chuyển request cho index.php: permalink
# /%postname%/ cần luật này. WordPress có thể tự viết lại đoạn giữa hai dấu
# BEGIN/END khi lưu permalink; dòng đầu của tpan nằm ngoài nên không mất.

# BEGIN WordPress
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
# END WordPress
