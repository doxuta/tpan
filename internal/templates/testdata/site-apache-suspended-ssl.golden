# Do tpan quản lý. Sửa tay sẽ bị tpan health báo lệch.
#
# Vhost Apache của site example.com khi đang TẠM KHOÁ, bản đã có chứng chỉ: cả
# cổng 80 lẫn 443 trả 403 kèm trang tạm khoá chung của tpan (cần mod ssl). Cổng
# 80 không chuyển sang https (chuyển rồi cũng chỉ gặp 403); nó vẫn phục vụ thử
# thách Let's Encrypt để chứng chỉ gia hạn được. Không trỏ tới mã nguồn hay
# pool PHP của site.
<VirtualHost *:80>
    ServerName example.com
    # DocumentRoot là thư mục trang tạm khoá, không phải public của site:
    # vhost thường cho .htaccess trong public ghi đè luật, nó có thể mở lại site.
    DocumentRoot "/var/lib/tpan/suspended"

    ErrorLog "/var/log/tpan/sites/example.com/error.log"
    CustomLog "/var/log/tpan/sites/example.com/access.log" combined

    # Gia hạn chứng chỉ đi qua cổng 80 (certbot --webroot).
    Alias /.well-known/acme-challenge/ "/var/lib/tpan/acme/.well-known/acme-challenge/"
    <Directory "/var/lib/tpan/acme/.well-known/acme-challenge">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    <Directory "/var/lib/tpan/suspended">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    # ErrorDocument với đường dẫn cục bộ giữ nguyên mã 403, chỉ thay thân.
    ErrorDocument 403 /tpan-suspended.html

    # Chặn mọi thứ trừ thử thách. REDIRECT_STATUS chỉ có ở lượt chuyển nội bộ
    # của ErrorDocument: lượt đó được đi tiếp để đọc trang tạm khoá.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^ - [F]
</VirtualHost>

<VirtualHost *:443>
    ServerName example.com
    DocumentRoot "/var/lib/tpan/suspended"

    SSLEngine on
    SSLCertificateFile "/etc/letsencrypt/live/example.com/fullchain.pem"
    SSLCertificateKeyFile "/etc/letsencrypt/live/example.com/privkey.pem"

    ErrorLog "/var/log/tpan/sites/example.com/error.log"
    CustomLog "/var/log/tpan/sites/example.com/access.log" combined

    <Directory "/var/lib/tpan/suspended">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    ErrorDocument 403 /tpan-suspended.html

    RewriteEngine On
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^ - [F]
</VirtualHost>
