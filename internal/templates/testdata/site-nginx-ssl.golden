# Do tpan quản lý. Sửa tay sẽ bị tpan health báo lệch.
#
# Vhost Nginx của site example.com, bản đã có chứng chỉ: cổng 80 chỉ còn để gia
# hạn chứng chỉ và chuyển sang https; site chạy ở cổng 443.

server {
    # Không có default_server: request không khớp tên nào rơi vào tpan-default.
    listen 80;
    listen [::]:80;
    server_name example.com;

    access_log /var/log/tpan/sites/example.com/access.log;
    error_log /var/log/tpan/sites/example.com/error.log;

    # Gia hạn chứng chỉ vẫn đi qua cổng 80 (certbot --webroot), nên thử thách
    # phải được phục vụ thẳng, không bị chuyển hướng.
    # ^~: khớp tiền tố này thì Nginx không xét location nào khác bên dưới.
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/tpan/acme;
    }

    # Mọi đường dẫn khác chuyển sang https, giữ nguyên đường dẫn và query.
    # Dùng tên domain cố định thay vì $host: $host lấy từ request, kẻ gửi
    # Host lạ sẽ bắt được trình duyệt đi tới tên đó.
    location / {
        return 301 https://example.com$request_uri;
    }
}

server {
    # "ssl" ở dòng listen là cách bật TLS của Nginx 1.24 (Ubuntu 24.04). Không
    # dùng "http2 on;": directive đó cần Nginx 1.25.1 trở lên.
    # Không có default_server: request lạ vào 443 rơi vào tpan-default-ssl.
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name example.com;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # Cố ý không bật HSTS (Strict-Transport-Security): chứng chỉ staging trình
    # duyệt không tin, và HSTS sẽ khoá người dùng ngoài site, không cho bấm
    # "tiếp tục" nữa.

    root /var/www/example.com/public;
    # Nginx chạy dưới www-data và đọc được file của mọi site qua quyền nhóm.
    # Thiếu dòng dưới, site A chỉ cần đặt một symlink trỏ sang file của site B
    # là Nginx trả file đó về, kể cả mã nguồn PHP nếu symlink mang đuôi .txt.
    # if_not_owner: chỉ đi theo symlink khi symlink và file đích cùng một chủ,
    # nên symlink của site trỏ vào file của chính nó vẫn chạy.
    # Không giới hạn phần được xét: nginx xét mọi thành phần của đường dẫn, kể
    # cả chính thư mục public, nên site không đổi được public thành symlink
    # sang thư mục của site khác.
    disable_symlinks if_not_owner;
    index index.php;

    # Log riêng từng site, trong thư mục mà /etc/logrotate.d/tpan-sites xoay vòng.
    access_log /var/log/tpan/sites/example.com/access.log;
    error_log /var/log/tpan/sites/example.com/error.log;

    # Giới hạn upload 64 MB (pool PHP đặt cùng mức).
    client_max_body_size 64m;

    # Từ đây tới hết server là đúng các luật của bản cổng 80 (site-nginx.conf.tmpl):
    # có chứng chỉ rồi thì không được mất luật bảo mật nào.

    # Các location regex được xét theo thứ tự trong file, cái khớp đầu tiên
    # thắng, nên hai luật chặn phải đứng trước location của PHP.

    # Chặn file và thư mục ẩn (.git, .env, .htaccess...), trừ .well-known.
    location ~ /\.(?!well-known/) {
        deny all;
    }

    # Không chạy PHP trong thư mục upload: file .php ai đó tải lên được (qua lỗi
    # của plugin) cũng không thành mã chạy được.
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }

    # Permalink của WordPress: không có file hay thư mục đúng tên thì chuyển cho index.php.
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        # Chỉ chuyển cho PHP file .php có thật. Không có dòng này thì
        # /uploads/anh.jpg/x.php có thể khiến PHP chạy anh.jpg như mã.
        try_files $uri =404;
        # fastcgi.conf của Ubuntu chính là fastcgi_params cộng dòng SCRIPT_FILENAME
        # này. Gói nginx của nginx.org không có fastcgi.conf, nên ghi rõ cả hai để
        # vhost chạy được với cả hai gói.
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/tpan-example_com_a379a6-8.3.sock;
    }
}
